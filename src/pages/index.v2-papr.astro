---
export const prerender = false

import Layout from '../layouts/Layout.astro'
import { fetchAllFeeds, FEEDS } from '../lib/feeds'

const { posts, failedCount, fetchedAt } = await fetchAllFeeds()

const feedCounts = new Map<string, number>()
for (const post of posts) {
  feedCounts.set(post.feedName, (feedCounts.get(post.feedName) ?? 0) + 1)
}

const activeFeedsJson = FEEDS
  .map(f => ({ name: f.name, color: f.color, count: feedCounts.get(f.name) ?? 0 }))
  .filter(f => f.count > 0)
  .sort((a, b) => b.count - a.count)

const postsJson = posts.map(p => ({
  title:     p.title,
  url:       p.url,
  feedName:  p.feedName,
  feedColor: p.feedColor,
  date:      p.date.toISOString(),
  excerpt:   p.excerpt,
  imageUrl:  p.imageUrl,
}))

const onlineCount = FEEDS.length - failedCount
const nextRefresh = new Date(fetchedAt.getTime() + 6 * 60 * 60 * 1000)
---

<Layout>

<!-- ════════════════════════════════════
     TOP BANNER
════════════════════════════════════ -->
<div class="top-banner">
  <div class="top-banner-inner">
    <div class="top-banner-left">
      <span class="live-pip" aria-hidden="true"></span>
      <span class="top-stat"><strong>{posts.length}</strong> articles from <strong>{onlineCount}</strong> sources</span>
      {failedCount > 0 && <span class="top-warn">· {failedCount} offline</span>}
    </div>
    <div class="top-banner-logo" aria-label="permit any any">
      <span class="logo-mono">permit</span><span class="logo-accent">-any-any</span>
    </div>
    <div class="top-banner-right">
      <span class="top-refresh">Refreshes every 6 hrs</span>
    </div>
  </div>
</div>


<!-- ════════════════════════════════════
     STICKY NAV
════════════════════════════════════ -->
<header id="site-nav">
  <div class="nav-wrap">

    <a href="/" class="nav-logo" aria-label="permit-any-any home">
      <span class="nav-logo-mono">$ </span><span class="nav-logo-red">permit</span><span class="nav-logo-dark">-any-any</span><span class="nav-blink" aria-hidden="true">▋</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href="#stories" class="nav-link">Latest</a>
      <a href="#trending-sec" class="nav-link">Trending</a>
      <a href="#sources-sec" class="nav-link">Sources</a>
    </nav>

    <div class="nav-actions">
      <div class="search-wrap" role="search">
        <label for="q" class="sr-only">Search articles</label>
        <svg class="search-icon" width="14" height="14" viewBox="0 0 20 20" fill="none"
             stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <circle cx="9" cy="9" r="6"/><path d="M15 15l3.5 3.5"/>
        </svg>
        <input id="q" type="search" class="search-input" placeholder="Search posts…" autocomplete="off" spellcheck="false" />
      </div>

      <div class="sort-pill" role="group" aria-label="Sort">
        <button class="sort-btn active" data-sort="date" aria-pressed="true">Latest</button>
        <button class="sort-btn" data-sort="source" aria-pressed="false">A–Z</button>
      </div>
    </div>

  </div>
</header>


<!-- ════════════════════════════════════
     HERO SLIDER
════════════════════════════════════ -->
<section id="hero-section" aria-label="Featured articles">
  <div id="hero-stage" class="hero-stage">
    <!-- JS fills this -->
    <div class="hero-skeleton" aria-hidden="true">
      <div class="hero-sk-overlay"></div>
      <div class="hero-sk-content">
        <div class="sk sk-badge"></div>
        <div class="sk sk-h1"></div>
        <div class="sk sk-h1" style="width:70%"></div>
        <div class="sk sk-meta"></div>
      </div>
    </div>
  </div>

  <!-- Arrows -->
  <button id="hero-prev" class="hero-arrow hero-arrow-left" aria-label="Previous article">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <button id="hero-next" class="hero-arrow hero-arrow-right" aria-label="Next article">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  </button>

  <!-- Dots -->
  <div id="hero-dots" class="hero-dots" role="tablist" aria-label="Slide indicators"></div>
</section>


<!-- ════════════════════════════════════
     MAIN CONTENT
════════════════════════════════════ -->
<div class="page-wrap content-grid" id="stories">

  <!-- ── Left: article feed ── -->
  <main>

    <!-- Section header -->
    <div class="sec-header">
      <h2 class="sec-title">Latest Stories</h2>
      <div class="sec-line"></div>
      <span id="results-count" class="results-count" aria-live="polite"></span>
      <button id="clear-filter" class="clear-btn" hidden>Clear ×</button>
    </div>

    <!-- Active filter pill -->
    <div id="filter-banner" class="filter-banner" hidden>
      Showing: <strong id="filter-name"></strong>
      <button id="clear-filter2" class="filter-clear-btn" aria-label="Clear filter">×</button>
    </div>

    <!-- Card grid -->
    <div id="card-grid" class="card-grid">
      {Array.from({ length: 6 }).map(() => (
        <div class="card-skeleton" aria-hidden="true">
          <div class="sk sk-card-img"></div>
          <div class="card-sk-body">
            <div class="sk sk-badge-sm"></div>
            <div class="sk sk-title"></div>
            <div class="sk sk-title" style="width:75%"></div>
            <div class="sk sk-meta-sm"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="empty-state" hidden>
      <p class="empty-title">No articles match your search</p>
      <button id="empty-clear" class="clear-btn">Reset filter</button>
    </div>

    <!-- Trending section -->
    <div class="sec-header" id="trending-sec" style="margin-top:2.5rem">
      <h2 class="sec-title">Trending Now</h2>
      <div class="sec-line"></div>
    </div>
    <ol id="trending-list" class="trending-list"></ol>

  </main>


  <!-- ── Right: sidebar ── -->
  <aside>

    <!-- Categories -->
    <div class="widget" id="sources-sec">
      <h3 class="widget-title">Browse Sources</h3>
      <div id="cat-grid" class="cat-grid" role="group" aria-label="Filter by source"></div>
    </div>

    <!-- Popular compact list -->
    <div class="widget" style="margin-top:1.5rem">
      <h3 class="widget-title">Popular This Week</h3>
      <ol id="popular-list" class="popular-list"></ol>
    </div>

  </aside>

</div>


<!-- ════════════════════════════════════
     FOOTER
════════════════════════════════════ -->
<footer class="site-footer">
  <div class="page-wrap footer-inner">
    <div>
      <div class="footer-logo">permit<span style="color:var(--crimson)">-any-any</span></div>
      <p class="footer-sub">Curated network automation &amp; DevNetOps reading.</p>
    </div>
    <div class="footer-meta">
      <p>{posts.length} articles · {onlineCount} sources · refreshes every 6 hrs</p>
      {failedCount > 0 && <p style="color:#f59e0b">{failedCount} source{failedCount > 1 ? 's' : ''} currently offline</p>}
    </div>
  </div>
</footer>

</Layout>


<!-- ════════════════════════════════════
     STYLES
════════════════════════════════════ -->
<style>
  /* ─── Utilities ──────────────────── */
  .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0 }
  .page-wrap { max-width:1200px;margin:0 auto;padding:0 1.25rem }

  /* ─── Top banner ─────────────────── */
  .top-banner { background:#111;border-bottom:2px solid var(--crimson) }
  .top-banner-inner {
    max-width:1200px;margin:0 auto;padding:0.6rem 1.25rem;
    display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem
  }
  .top-banner-left  { display:flex;align-items:center;gap:0.5rem;font-size:0.68rem;color:#888 }
  .top-banner-right { text-align:right;font-size:0.65rem;color:#555 }
  .top-banner-logo  {
    font-size:clamp(1rem,3vw,1.6rem);font-weight:900;letter-spacing:0.04em;
    text-align:center;color:#fff;line-height:1;padding:0.25rem 0
  }
  .logo-accent { color:var(--crimson) }
  .logo-mono   { color:#fff }
  .top-stat strong { color:#ddd }
  .top-warn { color:#f59e0b }
  .top-refresh { color:#555 }
  .live-pip {
    width:6px;height:6px;border-radius:50%;background:#22c55e;flex-shrink:0;
    animation:pulse-live 2.5s ease-in-out infinite
  }

  /* ─── Sticky nav ─────────────────── */
  #site-nav {
    position:sticky;top:0;z-index:100;
    background:rgba(255,255,255,0.97);backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border);
    box-shadow:0 1px 12px rgba(0,0,0,0.06)
  }
  .nav-wrap {
    max-width:1200px;margin:0 auto;
    padding:0 1.25rem;height:58px;
    display:flex;align-items:center;gap:1.25rem
  }
  .nav-logo {
    font-family:'JetBrains Mono',monospace;font-size:0.95rem;font-weight:700;
    letter-spacing:-0.02em;text-decoration:none;display:flex;align-items:baseline;gap:0;
    flex-shrink:0
  }
  .nav-logo-mono  { color:var(--text-faint);font-size:0.8em }
  .nav-logo-red   { color:var(--crimson) }
  .nav-logo-dark  { color:var(--ink) }
  .nav-blink      { color:var(--crimson);animation:blink 1.1s step-end infinite;margin-left:1px }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  .nav-links { display:flex;align-items:center;gap:0;flex:1 }
  @media(max-width:680px){.nav-links{display:none}}
  .nav-link {
    padding:0.35rem 0.75rem;font-size:0.8rem;font-weight:500;
    color:var(--text-muted);border-radius:4px;
    transition:color 0.12s,background 0.12s
  }
  .nav-link:hover { color:var(--ink);background:#f3f4f6 }

  .nav-actions { display:flex;align-items:center;gap:0.625rem;margin-left:auto }

  .search-wrap { position:relative;display:flex;align-items:center }
  .search-icon { position:absolute;left:0.625rem;color:var(--text-faint);pointer-events:none }
  .search-input {
    padding:0.4rem 0.75rem 0.4rem 2.1rem;
    background:var(--bg-page);border:1.5px solid var(--border);
    border-radius:20px;font-family:inherit;font-size:0.8rem;
    color:var(--ink);outline:none;width:200px;
    transition:border-color 0.15s,box-shadow 0.15s,width 0.25s
  }
  .search-input::placeholder { color:var(--text-faint) }
  .search-input:focus {
    border-color:var(--crimson);
    box-shadow:0 0 0 3px rgba(198,40,40,0.1);
    width:260px
  }
  @media(max-width:520px){.search-input{width:140px}.search-input:focus{width:160px}}

  .sort-pill { display:flex;border:1.5px solid var(--border);border-radius:20px;overflow:hidden }
  .sort-btn {
    padding:0.3rem 0.75rem;border:none;background:var(--bg-card);
    color:var(--text-muted);font-family:inherit;font-size:0.72rem;font-weight:500;
    cursor:pointer;transition:background 0.1s,color 0.1s
  }
  .sort-btn+.sort-btn { border-left:1.5px solid var(--border) }
  .sort-btn.active,.sort-btn[aria-pressed="true"] { background:var(--ink);color:#fff;font-weight:600 }
  .sort-btn:hover:not(.active) { background:var(--bg-page);color:var(--ink) }
  .sort-btn:focus-visible { outline:2px solid var(--crimson);outline-offset:-2px }

  /* ─── Hero ───────────────────────── */
  #hero-section {
    position:relative;background:#0d0d0d;
    overflow:hidden
  }
  .hero-stage {
    width:100%;height:clamp(320px,50vw,560px);
    position:relative;overflow:hidden
  }
  .hero-slide {
    position:absolute;inset:0;
    display:flex;align-items:flex-end;
    text-decoration:none;color:inherit;
    animation:heroFadeIn 0.5s ease both
  }
  @keyframes heroFadeIn { from{opacity:0} to{opacity:1} }

  .hero-bg {
    position:absolute;inset:0;
    width:100%;height:100%;object-fit:cover;
    z-index:1;
    transform-origin:center;
    transition:transform 8s linear
  }
  .hero-slide.active .hero-bg { transform:scale(1.06) }
  /* Hero placeholder fills the stage via img-ph which is already absolute */
  .hero-slide .img-ph { z-index:0 }
  .hero-overlay { z-index:2 }
  .hero-content { z-index:3 }
  .hero-overlay {
    position:absolute;inset:0;
    background:linear-gradient(
      to right,
      rgba(0,0,0,0.85) 0%,
      rgba(0,0,0,0.55) 50%,
      rgba(0,0,0,0.15) 100%
    ),linear-gradient(
      to top,
      rgba(0,0,0,0.7) 0%,
      transparent 60%
    )
  }
  .hero-content {
    position:relative;z-index:1;
    padding:2.5rem 2.5rem 2.5rem;
    max-width:640px
  }
  .hero-badge {
    display:inline-block;
    padding:0.25rem 0.75rem;
    border-radius:2px;font-size:0.62rem;font-weight:700;
    letter-spacing:0.1em;text-transform:uppercase;
    color:#fff;margin-bottom:1rem
  }
  .hero-title {
    font-size:clamp(1.5rem,3.5vw,2.5rem);font-weight:800;
    line-height:1.2;letter-spacing:-0.025em;color:#fff;
    margin-bottom:1.25rem;
    display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;
    text-shadow:0 2px 8px rgba(0,0,0,0.3)
  }
  .hero-meta {
    display:flex;align-items:center;gap:0.875rem;flex-wrap:wrap
  }
  .hero-source-chip {
    display:inline-flex;align-items:center;gap:0.4rem;
    background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);
    border-radius:20px;padding:0.22rem 0.7rem;
    font-size:0.7rem;font-weight:600;color:#fff
  }
  .hero-source-dot { width:7px;height:7px;border-radius:50%;flex-shrink:0 }
  .hero-date { font-size:0.72rem;color:rgba(255,255,255,0.6) }
  .hero-cta {
    display:inline-flex;align-items:center;gap:0.4rem;
    border:1.5px solid rgba(255,255,255,0.6);border-radius:2px;
    padding:0.35rem 1rem;font-size:0.68rem;font-weight:700;
    letter-spacing:0.08em;text-transform:uppercase;color:#fff;
    background:transparent;text-decoration:none;margin-left:auto;
    transition:background 0.15s,border-color 0.15s;flex-shrink:0
  }
  .hero-slide:hover .hero-cta { background:rgba(255,255,255,0.15);border-color:#fff }

  /* Arrows */
  .hero-arrow {
    position:absolute;top:50%;transform:translateY(-50%);
    z-index:10;width:44px;height:44px;
    background:rgba(255,255,255,0.12);border:1.5px solid rgba(255,255,255,0.3);
    border-radius:50%;color:#fff;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    transition:background 0.15s,border-color 0.15s;backdrop-filter:blur(4px)
  }
  .hero-arrow:hover { background:rgba(255,255,255,0.28);border-color:rgba(255,255,255,0.6) }
  .hero-arrow:focus-visible { outline:2px solid #fff;outline-offset:2px }
  .hero-arrow-left  { left:1.25rem }
  .hero-arrow-right { right:1.25rem }

  /* Dots */
  .hero-dots {
    position:absolute;bottom:1rem;left:50%;transform:translateX(-50%);
    z-index:10;display:flex;gap:0.45rem;align-items:center
  }
  .hero-dot {
    width:7px;height:7px;border-radius:50%;
    background:rgba(255,255,255,0.35);border:none;padding:0;cursor:pointer;
    transition:background 0.2s,transform 0.2s
  }
  .hero-dot.active,.hero-dot[aria-selected="true"] {
    background:#fff;transform:scale(1.3)
  }
  .hero-skeleton {
    width:100%;height:100%;background:#1a1a1a;
    display:flex;align-items:flex-end;padding:2.5rem;position:relative
  }
  .hero-sk-overlay { position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.7),transparent) }
  .hero-sk-content { position:relative;z-index:1;display:flex;flex-direction:column;gap:0.75rem;width:55% }

  /* ─── Content grid ───────────────── */
  .content-grid {
    display:grid;
    grid-template-columns:1fr 300px;
    gap:3rem;
    padding-top:2.5rem;
    padding-bottom:4rem;
    align-items:start
  }
  @media(max-width:1024px){.content-grid{grid-template-columns:1fr;gap:2rem}}

  /* ─── Section header ─────────────── */
  .sec-header {
    display:flex;align-items:center;gap:0.875rem;
    margin-bottom:1.5rem;
    border-bottom:2px solid var(--ink);
    padding-bottom:0.75rem
  }
  .sec-title {
    font-size:0.7rem;font-weight:800;
    letter-spacing:0.14em;text-transform:uppercase;
    color:var(--ink);white-space:nowrap
  }
  .sec-line { flex:1;height:0 /* border carries it */ }
  .results-count { font-size:0.72rem;color:var(--text-faint);white-space:nowrap }
  .clear-btn {
    font-size:0.7rem;font-weight:600;color:var(--crimson);
    background:var(--crimson-50);border:1px solid var(--crimson-100);
    border-radius:20px;padding:0.2rem 0.7rem;
    cursor:pointer;transition:background 0.1s;white-space:nowrap
  }
  .clear-btn:hover { background:var(--crimson-100) }
  .clear-btn:focus-visible { outline:2px solid var(--crimson);outline-offset:2px }

  .filter-banner {
    display:flex;align-items:center;gap:0.5rem;
    background:var(--crimson-50);border:1px solid var(--crimson-100);
    border-left:3px solid var(--crimson);
    border-radius:0 4px 4px 0;padding:0.5rem 0.875rem;
    font-size:0.8rem;color:var(--text-body);margin-bottom:1.25rem
  }
  .filter-banner strong { color:var(--crimson) }
  .filter-clear-btn {
    margin-left:auto;border:none;background:none;
    font-size:1rem;color:var(--crimson);cursor:pointer;line-height:1;
    padding:0 0.25rem
  }

  /* ─── Universal image placeholder ── */
  /*
   * Layered approach: placeholder div sits behind the <img>.
   * If img loads → it covers the placeholder naturally.
   * If img fails → onerror="this.style.display='none'" reveals placeholder.
   * No innerHTML manipulation, no quote-escaping bugs.
   */
  .img-ph {
    position:absolute;inset:0;
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.5rem;
    /* dot-grid texture over the feed colour */
    background-image:
      radial-gradient(circle, rgba(255,255,255,0.18) 1.5px, transparent 1.5px),
      radial-gradient(ellipse at 20% 80%, rgba(255,255,255,0.12) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 20%, rgba(0,0,0,0.15) 0%, transparent 50%);
    background-size: 18px 18px, 100% 100%, 100% 100%;
    background-color: var(--ph-color, #555)
  }
  .ph-circle {
    width:52px;height:52px;border-radius:50%;
    background:rgba(255,255,255,0.2);
    border:2px solid rgba(255,255,255,0.35);
    display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;
    font-size:1.1rem;font-weight:700;
    color:#fff;letter-spacing:0.04em;
    text-shadow:0 1px 4px rgba(0,0,0,0.4)
  }
  .ph-label {
    font-size:0.58rem;font-weight:600;letter-spacing:0.12em;
    text-transform:uppercase;color:rgba(255,255,255,0.6);
    max-width:80%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center
  }
  /* Smaller variant for thumbnails */
  .ph-circle-sm {
    width:32px;height:32px;font-size:0.65rem
  }

  /* ─── Vertical card grid ─────────── */
  .card-grid {
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:1.5rem
  }
  @media(max-width:900px){.card-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:480px){.card-grid{grid-template-columns:1fr}}

  /* ─── Story card (vertical) ──────── */
  .story-card {
    display:flex;flex-direction:column;
    text-decoration:none;color:inherit;
    background:var(--bg-card);
    border:1px solid var(--border);
    border-radius:8px;overflow:hidden;
    box-shadow:0 1px 4px rgba(0,0,0,0.05);
    transition:box-shadow 0.22s,transform 0.22s;
    animation:fadeUp 0.3s ease both
  }
  .story-card:hover {
    box-shadow:0 10px 32px rgba(0,0,0,0.12);
    transform:translateY(-4px)
  }
  .story-card:focus-visible { outline:2px solid var(--crimson);outline-offset:2px }

  .sc-img-wrap {
    position:relative;
    flex-shrink:0;
    height:195px;overflow:hidden;
    background:#f3f4f6
  }
  .sc-img {
    position:absolute;inset:0;
    width:100%;height:100%;object-fit:cover;display:block;
    transition:transform 0.45s ease
  }
  .story-card:hover .sc-img { transform:scale(1.07) }
  .sc-badge {
    position:absolute;bottom:0.625rem;left:0.625rem;z-index:1;
    display:inline-block;padding:0.22rem 0.625rem;
    border-radius:2px;font-size:0.58rem;font-weight:700;
    letter-spacing:0.1em;text-transform:uppercase;color:#fff;
    max-width:calc(100% - 1.25rem);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
    box-shadow:0 1px 4px rgba(0,0,0,0.25)
  }

  .sc-body {
    padding:1rem 1rem 1.125rem;
    display:flex;flex-direction:column;flex:1;gap:0.5rem
  }
  .sc-title {
    font-size:0.92rem;font-weight:700;line-height:1.45;
    letter-spacing:-0.01em;color:var(--ink);
    display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;
    transition:color 0.14s
  }
  .story-card:hover .sc-title { color:var(--crimson) }
  .sc-divider { height:1px;background:var(--border);margin:0.125rem 0 }
  .sc-meta {
    display:flex;align-items:center;gap:0.4rem;
    font-size:0.67rem;color:var(--text-faint);margin-top:auto
  }
  .sc-dot { width:5px;height:5px;border-radius:50%;flex-shrink:0 }
  .sc-source { font-weight:600;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap }

  /* ─── Trending numbered list ─────── */
  .trending-list { list-style:none;display:flex;flex-direction:column;gap:0 }
  .trend-item {
    display:flex;align-items:center;gap:0.875rem;
    padding:0.875rem 0;
    border-bottom:1px solid var(--border);
    text-decoration:none;color:inherit;
    transition:background 0.12s;
    animation:fadeUp 0.3s ease both
  }
  .trend-item:last-child { border-bottom:none;padding-bottom:0 }
  .trend-item:first-child { padding-top:0 }
  .trend-item:focus-visible { outline:2px solid var(--crimson);outline-offset:2px;border-radius:4px }

  .trend-num {
    font-family:'JetBrains Mono',monospace;
    font-size:1.75rem;font-weight:900;
    color:var(--border);line-height:1;flex-shrink:0;
    width:32px;text-align:right;
    transition:color 0.15s
  }
  .trend-item:hover .trend-num { color:var(--crimson) }

  .trend-thumb {
    position:relative;
    flex-shrink:0;width:84px;height:68px;
    border-radius:4px;overflow:hidden;background:#f3f4f6
  }
  .trend-thumb img {
    position:absolute;inset:0;
    width:100%;height:100%;object-fit:cover;display:block
  }

  .trend-content { flex:1;min-width:0 }
  .trend-badge {
    display:inline-block;padding:0.15rem 0.5rem;
    border-radius:2px;font-size:0.55rem;font-weight:700;
    letter-spacing:0.1em;text-transform:uppercase;color:#fff;
    margin-bottom:0.3rem;
    max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap
  }
  .trend-title {
    font-size:0.82rem;font-weight:600;line-height:1.4;
    color:var(--ink);
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
    transition:color 0.12s
  }
  .trend-item:hover .trend-title { color:var(--crimson) }
  .trend-meta { font-size:0.65rem;color:var(--text-faint);margin-top:0.25rem }

  /* ─── Sidebar ────────────────────── */
  aside { position:sticky;top:74px;display:flex;flex-direction:column;gap:0 }
  @media(max-width:1024px){aside{position:static}}
  .widget { padding:0 }
  .widget-title {
    font-size:0.68rem;font-weight:800;letter-spacing:0.14em;
    text-transform:uppercase;color:var(--ink);
    padding-bottom:0.625rem;margin-bottom:0.875rem;
    border-bottom:2px solid var(--ink);display:block
  }

  /* Category grid */
  .cat-grid { display:grid;grid-template-columns:1fr 1fr;gap:0.5rem }
  .cat-btn {
    display:flex;align-items:center;justify-content:space-between;gap:0.4rem;
    padding:0.5rem 0.625rem;
    background:var(--bg-page);border:1.5px solid var(--border);
    border-radius:4px;cursor:pointer;font-family:inherit;
    font-size:0.72rem;font-weight:500;color:var(--text-body);
    transition:border-color 0.12s,background 0.12s,color 0.12s;
    text-align:left;overflow:hidden
  }
  .cat-btn:hover { border-color:var(--text-muted);color:var(--ink);background:var(--bg-card) }
  .cat-btn.active { border-color:var(--crimson);background:var(--crimson-50);color:var(--crimson);font-weight:700 }
  .cat-btn:focus-visible { outline:2px solid var(--crimson);outline-offset:2px }
  .cat-name { overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0 }
  .cat-count {
    flex-shrink:0;font-size:0.62rem;font-weight:700;
    background:var(--border);color:var(--text-muted);
    border-radius:20px;padding:0.1rem 0.45rem
  }
  .cat-btn.active .cat-count { background:var(--crimson);color:#fff }

  /* Popular compact list */
  .popular-list { list-style:none;display:flex;flex-direction:column }
  .pop-item {
    display:flex;align-items:center;gap:0.75rem;
    padding:0.75rem 0;border-bottom:1px solid var(--border);
    text-decoration:none;color:inherit
  }
  .pop-item:first-child { padding-top:0 }
  .pop-item:last-child  { border-bottom:none;padding-bottom:0 }
  .pop-item:focus-visible { outline:2px solid var(--crimson);outline-offset:2px;border-radius:3px }
  .pop-thumb {
    position:relative;
    flex-shrink:0;width:68px;height:56px;
    border-radius:3px;overflow:hidden;background:#f3f4f6
  }
  .pop-thumb img {
    position:absolute;inset:0;
    width:100%;height:100%;object-fit:cover;display:block
  }
  .pop-content { flex:1;min-width:0 }
  .pop-title {
    font-size:0.76rem;font-weight:600;line-height:1.4;
    color:var(--ink);
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
    transition:color 0.12s
  }
  .pop-item:hover .pop-title { color:var(--crimson) }
  .pop-meta { font-size:0.63rem;color:var(--text-faint);margin-top:0.2rem }

  /* ─── Footer ─────────────────────── */
  .site-footer { background:var(--ink);color:#9ca3af;margin-top:3rem }
  .footer-inner {
    padding:2.5rem 1.25rem 2rem;
    display:flex;align-items:flex-start;
    justify-content:space-between;gap:2rem;flex-wrap:wrap
  }
  .footer-logo { font-size:1.1rem;font-weight:800;letter-spacing:-0.03em;color:#fff;margin-bottom:0.4rem }
  .footer-sub  { font-size:0.78rem;color:#4b5563 }
  .footer-meta { font-size:0.75rem;color:#4b5563;text-align:right }

  /* ─── Skeletons ──────────────────── */
  .sk {
    background:linear-gradient(90deg,#f3f4f6 25%,#eaecee 50%,#f3f4f6 75%);
    background-size:200% 100%;
    animation:shimmer 1.5s ease-in-out infinite;
    border-radius:3px
  }
  .sk-badge    { height:20px;width:90px;border-radius:2px }
  .sk-h1       { height:34px;width:90%;background:rgba(255,255,255,0.1);border-radius:3px;animation:none }
  .sk-meta     { height:16px;width:35%;background:rgba(255,255,255,0.07);border-radius:3px;animation:none }
  .sk-card-img { height:180px;width:100%;border-radius:0 }
  .sk-badge-sm { height:18px;width:80px;border-radius:2px }
  .sk-title    { height:16px;width:95% }
  .sk-meta-sm  { height:12px;width:55%;margin-top:0.25rem }
  .card-skeleton { background:var(--bg-card);border:1px solid var(--border);border-radius:6px;overflow:hidden }
  .card-sk-body  { padding:1rem;display:flex;flex-direction:column;gap:0.45rem }

  /* ─── Empty ──────────────────────── */
  .empty-state { padding:4rem 0;text-align:center;display:flex;flex-direction:column;align-items:center;gap:0.75rem }
  .empty-title { font-size:1rem;font-weight:600;color:var(--ink) }

  /* ─── Animations ─────────────────── */
  @keyframes shimmer    { from{background-position:200% 0} to{background-position:-200% 0} }
  @keyframes fadeUp     { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
  @keyframes pulse-live { 0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,.4)} 50%{box-shadow:0 0 0 5px rgba(34,197,94,0)} }
</style>


<!-- ════════════════════════════════════
     CLIENT SCRIPT
════════════════════════════════════ -->
<script define:vars={{ postsJson, activeFeedsJson }}>
  const ALL_POSTS = postsJson
  const ALL_FEEDS = activeFeedsJson

  let filter = 'all'
  let query  = ''
  let sort   = 'date'

  // ── Helpers ──────────────────────────────

  const esc = s => String(s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;')

  const relDate = iso => {
    const d = Math.floor((Date.now() - new Date(iso)) / 86400000)
    if (d === 0) return 'Today'
    if (d === 1) return 'Yesterday'
    if (d < 7)   return `${d}d ago`
    if (d < 30)  return `${Math.floor(d/7)}w ago`
    if (d < 365) return `${Math.floor(d/30)}mo ago`
    return `${Math.floor(d/365)}y ago`
  }

  const fmtDate = iso => new Date(iso).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})

  const initials = name => name.split(/[\s\-_]+/).slice(0,2).map(w => w[0]?.toUpperCase()||'').join('')

  const shortName = name => name.split(' ').slice(0,3).join(' ')

  // Build a placeholder div + optional img stacked — no complex onerror needed
  const mkPh = (color, ini, label, circleClass) =>
    `<div class="img-ph" style="--ph-color:${esc(color)}">
       <div class="ph-circle ${circleClass||''}">${esc(ini)}</div>
       ${label ? `<div class="ph-label">${esc(label)}</div>` : ''}
     </div>`

  const mkImg = (url, cls) =>
    url ? `<img class="${cls}" src="${esc(url)}" alt="" loading="lazy" onerror="this.style.display='none'">` : ''

  // ── Hero slider ───────────────────────────

  let heroSlides = []
  let heroIdx    = 0
  let heroTimer  = null

  function heroPostsWithImage(posts) {
    const withImg = posts.filter(p => p.imageUrl)
    return withImg.length >= 3 ? withImg.slice(0, 6) : posts.slice(0, 6)
  }

  function renderHeroSlide(post) {
    const ini = initials(post.feedName)
    // Layered: placeholder behind, img on top (hides itself on error)
    const bgLayer = post.imageUrl
      ? `${mkPh(post.feedColor, ini, '', '')}<img class="hero-bg" src="${esc(post.imageUrl)}" alt="" loading="eager" onerror="this.style.display='none'">`
      : mkPh(post.feedColor, ini, post.feedName, '')

    return `
      <div class="hero-slide" role="tabpanel">
        ${bgLayer}
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <div class="hero-badge" style="background:${esc(post.feedColor)}">${esc(shortName(post.feedName))}</div>
          <h2 class="hero-title">${esc(post.title)}</h2>
          <div class="hero-meta">
            <span class="hero-source-chip">
              <span class="hero-source-dot" style="background:${esc(post.feedColor)}"></span>
              ${esc(post.feedName)}
            </span>
            <time class="hero-date" datetime="${esc(post.date)}">${fmtDate(post.date)}</time>
            <a class="hero-cta" href="${esc(post.url)}" target="_blank" rel="noopener noreferrer">Read More →</a>
          </div>
        </div>
      </div>
    `
  }

  function showHeroSlide(idx) {
    heroIdx = (idx + heroSlides.length) % heroSlides.length
    const stage = document.getElementById('hero-stage')
    stage.innerHTML = renderHeroSlide(heroSlides[heroIdx])
    // trigger scale animation
    requestAnimationFrame(() => stage.querySelector('.hero-slide')?.classList.add('active'))

    // Dots
    document.querySelectorAll('.hero-dot').forEach((d, i) => {
      d.classList.toggle('active', i === heroIdx)
      d.setAttribute('aria-selected', String(i === heroIdx))
    })
  }

  function startHeroAuto() {
    clearInterval(heroTimer)
    heroTimer = setInterval(() => showHeroSlide(heroIdx + 1), 6000)
  }

  function initHero(posts) {
    heroSlides = heroPostsWithImage(posts)
    if (!heroSlides.length) return

    // Dots
    const dotsEl = document.getElementById('hero-dots')
    dotsEl.innerHTML = heroSlides.map((_, i) =>
      `<button class="hero-dot${i===0?' active':''}" role="tab"
               aria-selected="${i===0}" aria-label="Slide ${i+1}"></button>`
    ).join('')

    dotsEl.querySelectorAll('.hero-dot').forEach((d, i) => {
      d.addEventListener('click', () => { showHeroSlide(i); startHeroAuto() })
    })

    showHeroSlide(0)
    startHeroAuto()
  }

  document.getElementById('hero-prev').addEventListener('click', () => { showHeroSlide(heroIdx - 1); startHeroAuto() })
  document.getElementById('hero-next').addEventListener('click', () => { showHeroSlide(heroIdx + 1); startHeroAuto() })

  // Pause on hover
  document.getElementById('hero-section').addEventListener('mouseenter', () => clearInterval(heroTimer))
  document.getElementById('hero-section').addEventListener('mouseleave', startHeroAuto)

  // ── Story cards ───────────────────────────

  function cardHTML(post, idx) {
    const delay = Math.min(idx * 30, 400)
    const ini   = initials(post.feedName)
    // Placeholder sits in position, image stacks on top absolutely
    return `
      <a class="story-card" href="${esc(post.url)}" target="_blank" rel="noopener noreferrer"
         style="animation-delay:${delay}ms" aria-label="${esc(post.title)}">
        <div class="sc-img-wrap">
          ${mkPh(post.feedColor, ini, post.feedName, '')}
          ${mkImg(post.imageUrl, 'sc-img')}
          <div class="sc-badge" style="background:${esc(post.feedColor)}">${esc(shortName(post.feedName))}</div>
        </div>
        <div class="sc-body">
          <div class="sc-title">${esc(post.title)}</div>
          <div class="sc-divider"></div>
          <div class="sc-meta">
            <span class="sc-dot" style="background:${esc(post.feedColor)}"></span>
            <span class="sc-source">${esc(shortName(post.feedName))}</span>
            <span>·</span>
            <time datetime="${esc(post.date)}">${relDate(post.date)}</time>
          </div>
        </div>
      </a>
    `
  }

  // ── Trending list ─────────────────────────

  function renderTrending(posts) {
    const list = document.getElementById('trending-list')
    const items = posts.slice(0, 8)
    list.innerHTML = items.map((p, i) => {
      const ini = initials(p.feedName)
      return `
        <li>
          <a class="trend-item" href="${esc(p.url)}" target="_blank" rel="noopener noreferrer"
             style="animation-delay:${i*40}ms">
            <span class="trend-num" aria-hidden="true">${String(i+1).padStart(2,'0')}</span>
            <div class="trend-thumb">
              ${mkPh(p.feedColor, ini, '', 'ph-circle-sm')}
              ${mkImg(p.imageUrl, '')}
            </div>
            <div class="trend-content">
              <div class="trend-badge" style="background:${esc(p.feedColor)}">${esc(shortName(p.feedName))}</div>
              <div class="trend-title">${esc(p.title)}</div>
              <div class="trend-meta">${esc(shortName(p.feedName))} · <time datetime="${esc(p.date)}">${relDate(p.date)}</time></div>
            </div>
          </a>
        </li>
      `
    }).join('')
  }

  // ── Sidebar: categories ───────────────────

  function renderCategories() {
    const grid = document.getElementById('cat-grid')
    const allBtn = `
      <button class="cat-btn ${filter==='all'?'active':''}" data-feed="all" aria-pressed="${filter==='all'}">
        <span class="cat-name">All</span>
        <span class="cat-count">${ALL_POSTS.length}</span>
      </button>`
    const feedBtns = ALL_FEEDS.map(f => `
      <button class="cat-btn ${filter===f.name?'active':''}" data-feed="${esc(f.name)}"
              aria-pressed="${filter===f.name}" title="${esc(f.name)}">
        <span class="cat-name">${esc(shortName(f.name))}</span>
        <span class="cat-count">${f.count}</span>
      </button>`
    ).join('')
    grid.innerHTML = allBtn + feedBtns

    grid.querySelectorAll('.cat-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        filter = btn.dataset.feed
        refresh()
      })
    })
  }

  // ── Sidebar: popular ──────────────────────

  function renderPopular() {
    const list = document.getElementById('popular-list')
    const items = ALL_POSTS.slice(0, 7)
    list.innerHTML = items.map(p => {
      const ini = initials(p.feedName)
      return `
        <li>
          <a class="pop-item" href="${esc(p.url)}" target="_blank" rel="noopener noreferrer"
             aria-label="${esc(p.title)}">
            <div class="pop-thumb">
              ${mkPh(p.feedColor, ini, '', 'ph-circle-sm')}
              ${mkImg(p.imageUrl, '')}
            </div>
            <div class="pop-content">
              <div class="pop-title">${esc(p.title)}</div>
              <div class="pop-meta">${esc(shortName(p.feedName))} · <time datetime="${esc(p.date)}">${relDate(p.date)}</time></div>
            </div>
          </a>
        </li>
      `
    }).join('')
  }

  // ── Main refresh ──────────────────────────

  function refresh() {
    let list = [...ALL_POSTS]

    if (filter !== 'all') list = list.filter(p => p.feedName === filter)

    const q = query.trim().toLowerCase()
    if (q) list = list.filter(p =>
      p.title.toLowerCase().includes(q) ||
      p.feedName.toLowerCase().includes(q) ||
      p.excerpt?.toLowerCase().includes(q)
    )

    if (sort === 'source') list.sort((a, b) => a.feedName.localeCompare(b.feedName))

    // Hero slides from filtered list
    initHero(list)

    // Cards (skip first 6 — hero uses them)
    const grid   = document.getElementById('card-grid')
    const empty  = document.getElementById('empty-state')
    const cards  = list.slice(6)

    if (list.length === 0) {
      grid.innerHTML = ''
      grid.style.display = 'none'
      empty.removeAttribute('hidden')
    } else {
      grid.style.display = 'grid'
      empty.setAttribute('hidden', '')
      grid.innerHTML = cards.map((p, i) => cardHTML(p, i)).join('')
    }

    // Trending from filtered
    renderTrending(list.slice(1, 9))

    // Results count
    document.getElementById('results-count').textContent =
      `${list.length} article${list.length !== 1 ? 's' : ''}`

    // Filter banner
    const banner = document.getElementById('filter-banner')
    if (filter !== 'all') {
      document.getElementById('filter-name').textContent = filter
      banner.removeAttribute('hidden')
    } else {
      banner.setAttribute('hidden', '')
    }

    // Clear button
    const clrBtn = document.getElementById('clear-filter')
    filter !== 'all' ? clrBtn.removeAttribute('hidden') : clrBtn.setAttribute('hidden', '')

    renderCategories()
  }

  // ── Controls ──────────────────────────────

  document.getElementById('q').addEventListener('input', e => {
    query = e.target.value; refresh()
  })
  document.addEventListener('keydown', e => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && !e.metaKey) {
      e.preventDefault(); document.getElementById('q').focus()
    }
  })

  document.querySelectorAll('.sort-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      sort = btn.dataset.sort
      document.querySelectorAll('.sort-btn').forEach(b => {
        const on = b.dataset.sort === sort
        b.classList.toggle('active', on)
        b.setAttribute('aria-pressed', String(on))
      })
      refresh()
    })
  })

  document.getElementById('clear-filter').addEventListener('click',  () => { filter = 'all'; refresh() })
  document.getElementById('clear-filter2').addEventListener('click', () => { filter = 'all'; refresh() })
  document.getElementById('empty-clear').addEventListener('click',   () => { filter = 'all'; refresh() })

  // ── Init ─────────────────────────────────

  renderPopular()
  renderCategories()
  refresh()
</script>
