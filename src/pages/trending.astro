---
export const prerender = false

interface ArticleClick {
  url: string
  title: string
  feed_name: string
  feed_color: string
  clicks: number
  last_clicked: string
}

const db = (Astro.locals.runtime?.env as Record<string, unknown>)?.DB as D1Database | undefined

let articles: ArticleClick[] = []
let dbError = false

if (db) {
  try {
    const result = await db
      .prepare('SELECT * FROM article_clicks ORDER BY clicks DESC LIMIT 50')
      .all<ArticleClick>()
    articles = result.results ?? []
  } catch {
    dbError = true
  }
}

function relDate(iso: string) {
  const diff = Date.now() - new Date(iso).getTime()
  const m = Math.floor(diff / 60000)
  if (m < 60) return `${m}m ago`
  const h = Math.floor(m / 60)
  if (h < 24) return `${h}h ago`
  return `${Math.floor(h / 24)}d ago`
}

function shortName(name: string) {
  return name.length > 22 ? name.slice(0, 20) + '…' : name
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trending — Permit-Any-Any</title>
    <meta name="description" content="The most-clicked network automation and DevNetOps articles on Permit-Any-Any." />
    <link rel="canonical" href="https://permit-any-any.com/trending" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;900&family=Manrope:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0 }

      :root {
        --crimson:        #C62828;
        --crimson-dark:   #8E0000;
        --surface:        #f7f9fb;
        --surface-card:   #ffffff;
        --on-surface:     #191c1e;
        --on-surface-var: #45464d;
        --outline:        #76777d;
        --outline-var:    #c6c6cd;
        --surface-tint:   #006398;
        --border:         rgba(198,198,205,0.3);
      }

      html { -webkit-font-smoothing: antialiased; scroll-behavior: smooth }
      body {
        background: var(--surface);
        color: var(--on-surface);
        font-family: 'Manrope', sans-serif;
        font-size: 15px;
        line-height: 1.6;
        min-height: 100dvh;
      }
      a { color: inherit; text-decoration: none }
      ::selection { background: #FFCDD2; color: var(--crimson-dark) }

      /* ── Nav ── */
      .nav {
        position: sticky; top: 0; z-index: 100;
        background: rgba(247,249,251,0.9);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
        padding: 0 1.5rem;
        display: flex; align-items: center; gap: 1rem; height: 56px;
      }
      .nav-logo {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1rem; font-weight: 700; letter-spacing: -0.02em;
        color: var(--crimson); text-decoration: none;
      }
      .nav-back {
        display: flex; align-items: center; gap: 0.35rem;
        font-size: 0.8rem; font-weight: 600; color: var(--outline);
        transition: color 0.15s;
      }
      .nav-back:hover { color: var(--on-surface) }
      .nav-sep { color: var(--outline-var); font-size: 0.8rem }
      .nav-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.85rem; font-weight: 600; color: var(--on-surface);
      }

      /* ── Page ── */
      .page { max-width: 780px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem }

      .page-header { margin-bottom: 2rem }
      .page-header h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        font-weight: 800; letter-spacing: -0.03em;
        color: var(--on-surface);
        display: flex; align-items: center; gap: 0.5rem;
      }
      .page-header p {
        margin-top: 0.4rem;
        font-size: 0.875rem; color: var(--outline);
      }

      /* ── Table ── */
      .trend-table { width: 100%; border-collapse: collapse }
      .trend-table th {
        text-align: left;
        font-family: 'Inter', sans-serif;
        font-size: 0.68rem; font-weight: 700;
        letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--outline);
        padding: 0 0.75rem 0.75rem;
        border-bottom: 1px solid var(--border);
      }
      .trend-table th:last-child { text-align: right }

      .trend-row {
        border-bottom: 1px solid var(--border);
        transition: background 0.12s;
      }
      .trend-row:hover { background: rgba(0,99,152,0.04) }
      .trend-row td { padding: 0.875rem 0.75rem; vertical-align: middle }

      .rank {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.75rem; font-weight: 700;
        color: var(--outline-var); width: 2rem;
        padding-right: 0;
      }
      .rank-top { color: var(--crimson) }

      .article-link {
        display: block;
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem; font-weight: 600;
        color: var(--on-surface);
        line-height: 1.35;
        transition: color 0.15s;
      }
      .article-link:hover { color: var(--surface-tint) }

      .source-badge {
        display: inline-flex; align-items: center; gap: 0.3rem;
        margin-top: 0.25rem;
        font-size: 0.72rem; color: var(--outline);
      }
      .source-dot {
        width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
      }

      .clicks-cell { text-align: right; white-space: nowrap }
      .clicks-count {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1rem; font-weight: 700;
        color: var(--on-surface);
      }
      .clicks-label {
        display: block;
        font-size: 0.65rem; color: var(--outline); font-weight: 500;
      }
      .last-clicked {
        display: block;
        font-size: 0.68rem; color: var(--outline-var);
        margin-top: 0.1rem;
      }

      /* ── Empty / error states ── */
      .empty {
        text-align: center; padding: 4rem 1rem;
        color: var(--outline);
        font-family: 'Inter', sans-serif; font-size: 0.875rem;
      }
      .empty strong { display: block; font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--on-surface) }

      @media (max-width: 540px) {
        .last-clicked { display: none }
        .trend-table th.col-time { display: none }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/" class="nav-logo">permit-any-any</a>
      <span class="nav-sep">/</span>
      <span class="nav-title">Trending</span>
      <a href="/" class="nav-back" style="margin-left:auto">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 2L4 7l5 5"/></svg>
        Back
      </a>
    </nav>

    <main class="page">
      <header class="page-header">
        <h1>🔥 Trending</h1>
        <p>Most-clicked articles across the network — updated in real time.</p>
      </header>

      {dbError && (
        <div class="empty">
          <strong>Couldn't load trending data</strong>
          Check back soon.
        </div>
      )}

      {!dbError && articles.length === 0 && (
        <div class="empty">
          <strong>No clicks tracked yet</strong>
          Start reading articles on the home page and they'll appear here.
        </div>
      )}

      {!dbError && articles.length > 0 && (
        <table class="trend-table">
          <thead>
            <tr>
              <th style="width:2.5rem">#</th>
              <th>Article</th>
              <th class="col-time" style="width:7rem">Last clicked</th>
              <th style="width:6rem">Clicks</th>
            </tr>
          </thead>
          <tbody>
            {articles.map((a, i) => (
              <tr class="trend-row">
                <td class={`rank${i < 3 ? ' rank-top' : ''}`}>{String(i + 1).padStart(2, '0')}</td>
                <td>
                  <a class="article-link" href={a.url} target="_blank" rel="noopener noreferrer">
                    {a.title}
                  </a>
                  <span class="source-badge">
                    <span class="source-dot" style={`background:${a.feed_color}`}></span>
                    {shortName(a.feed_name)}
                  </span>
                </td>
                <td class="col-time">
                  <span class="last-clicked">{relDate(a.last_clicked)}</span>
                </td>
                <td class="clicks-cell">
                  <span class="clicks-count">{a.clicks.toLocaleString()}</span>
                  <span class="clicks-label">click{a.clicks !== 1 ? 's' : ''}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </main>
  </body>
</html>
