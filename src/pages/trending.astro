---
export const prerender = false

import Layout from '../layouts/Layout.astro'

interface ArticleClick {
  url: string
  title: string
  feed_name: string
  feed_color: string
  clicks: number
  last_clicked: string
}

const db = (Astro.locals.runtime?.env as Record<string, unknown>)?.DB as D1Database | undefined

let articles: ArticleClick[] = []
let dbError = false

if (db) {
  try {
    const result = await db
      .prepare('SELECT * FROM article_clicks ORDER BY clicks DESC LIMIT 50')
      .all<ArticleClick>()
    articles = result.results ?? []
  } catch {
    dbError = true
  }
}

function relDate(iso: string) {
  const diff = Date.now() - new Date(iso).getTime()
  const m = Math.floor(diff / 60000)
  if (m < 60) return `${m}m ago`
  const h = Math.floor(m / 60)
  if (h < 24) return `${h}h ago`
  return `${Math.floor(h / 24)}d ago`
}

function shortName(name: string) {
  return name.length > 22 ? name.slice(0, 20) + '…' : name
}

const SITE_URL = 'https://permit-any-any.com'

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Trending Network Automation Articles — Permit-Any-Any',
  description: 'The most-clicked network automation and DevNetOps articles, ranked in real time by reader engagement.',
  url: `${SITE_URL}/trending`,
  isPartOf: { '@type': 'WebSite', url: SITE_URL },
}
---

<Layout
  title="Trending Network Automation Articles — Permit-Any-Any"
  description="The most-clicked network automation and DevNetOps articles, ranked in real time by reader engagement."
  pageSchema={pageSchema}
>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0 }

    a { color: inherit; text-decoration: none }
    ::selection { background: #FFCDD2; color: #8E0000 }

    /* ── Nav ── */
    .nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(247,249,251,0.9);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(198,198,205,0.3);
      padding: 0 1.5rem;
      display: flex; align-items: center; gap: 1rem; height: 56px;
    }
    .nav-logo {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem; font-weight: 700; letter-spacing: -0.02em;
      color: #C62828; text-decoration: none;
    }
    .nav-back {
      display: flex; align-items: center; gap: 0.35rem;
      font-size: 0.8rem; font-weight: 600; color: #76777d;
      transition: color 0.15s;
    }
    .nav-back:hover { color: #191c1e }
    .nav-sep { color: #c6c6cd; font-size: 0.8rem }
    .nav-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.85rem; font-weight: 600; color: #191c1e;
    }

    /* ── Page ── */
    .page { max-width: 780px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem }

    .page-header { margin-bottom: 2rem }
    .page-header h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      font-weight: 800; letter-spacing: -0.03em;
      color: #191c1e;
      display: flex; align-items: center; gap: 0.5rem;
    }
    .page-header p {
      margin-top: 0.4rem;
      font-size: 0.875rem; color: #76777d;
    }

    /* ── Table ── */
    .trend-table { width: 100%; border-collapse: collapse }
    .trend-table th {
      text-align: left;
      font-family: 'Inter', sans-serif;
      font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: #76777d;
      padding: 0 0.75rem 0.75rem;
      border-bottom: 1px solid rgba(198,198,205,0.3);
    }
    .trend-table th:last-child { text-align: right }

    .trend-row {
      border-bottom: 1px solid rgba(198,198,205,0.3);
      transition: background 0.12s;
    }
    .trend-row:hover { background: rgba(0,99,152,0.04) }
    .trend-row td { padding: 0.875rem 0.75rem; vertical-align: middle }

    .rank {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.75rem; font-weight: 700;
      color: #c6c6cd; width: 2rem;
      padding-right: 0;
    }
    .rank-top { color: #C62828 }

    .article-link {
      display: block;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem; font-weight: 600;
      color: #191c1e;
      line-height: 1.35;
      transition: color 0.15s;
    }
    .article-link:hover { color: #006398 }

    .source-badge {
      display: inline-flex; align-items: center; gap: 0.3rem;
      margin-top: 0.25rem;
      font-size: 0.72rem; color: #76777d;
    }
    .source-dot {
      width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
    }

    .clicks-cell { text-align: right; white-space: nowrap }
    .clicks-count {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem; font-weight: 700;
      color: #191c1e;
    }
    .clicks-label {
      display: block;
      font-size: 0.65rem; color: #76777d; font-weight: 500;
    }
    .last-clicked {
      display: block;
      font-size: 0.68rem; color: #c6c6cd;
      margin-top: 0.1rem;
    }

    /* ── Empty / error states ── */
    .empty {
      text-align: center; padding: 4rem 1rem;
      color: #76777d;
      font-family: 'Inter', sans-serif; font-size: 0.875rem;
    }
    .empty strong { display: block; font-size: 1.1rem; margin-bottom: 0.5rem; color: #191c1e }

    @media (max-width: 540px) {
      .last-clicked { display: none }
      .trend-table th.col-time { display: none }
    }
  </style>

  <nav class="nav" aria-label="Site navigation">
    <a href="/" class="nav-logo">permit-any-any</a>
    <span class="nav-sep" aria-hidden="true">/</span>
    <span class="nav-title">Trending</span>
    <a href="/" class="nav-back" style="margin-left:auto" aria-label="Back to home">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 2L4 7l5 5"/></svg>
      Back
    </a>
  </nav>

  <main class="page">
    <header class="page-header">
      <h1>🔥 Trending Network Automation Articles</h1>
      <p>Most-clicked articles across the network — updated in real time.</p>
    </header>

    {dbError && (
      <div class="empty">
        <strong>Couldn't load trending data</strong>
        Check back soon.
      </div>
    )}

    {!dbError && articles.length === 0 && (
      <div class="empty">
        <strong>No clicks tracked yet</strong>
        Start reading articles on the home page and they'll appear here.
      </div>
    )}

    {!dbError && articles.length > 0 && (
      <table class="trend-table" aria-label="Trending articles ranked by clicks">
        <thead>
          <tr>
            <th style="width:2.5rem" scope="col">#</th>
            <th scope="col">Article</th>
            <th class="col-time" style="width:7rem" scope="col">Last clicked</th>
            <th style="width:6rem" scope="col">Clicks</th>
          </tr>
        </thead>
        <tbody>
          {articles.map((a, i) => (
            <tr class="trend-row">
              <td class={`rank${i < 3 ? ' rank-top' : ''}`} aria-label={`Rank ${i + 1}`}>{String(i + 1).padStart(2, '0')}</td>
              <td>
                <a class="article-link" href={a.url} target="_blank" rel="noopener noreferrer">
                  {a.title}
                </a>
                <span class="source-badge">
                  <span class="source-dot" style={`background:${a.feed_color}`} aria-hidden="true"></span>
                  {shortName(a.feed_name)}
                </span>
              </td>
              <td class="col-time">
                <span class="last-clicked">{relDate(a.last_clicked)}</span>
              </td>
              <td class="clicks-cell">
                <span class="clicks-count">{a.clicks.toLocaleString()}</span>
                <span class="clicks-label">click{a.clicks !== 1 ? 's' : ''}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </main>
</Layout>
