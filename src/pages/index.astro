---
export const prerender = false

import Layout from '../layouts/Layout.astro'
import { fetchAllFeeds, FEEDS } from '../lib/feeds'

const { posts, failedCount, fetchedAt } = await fetchAllFeeds()

const feedCounts = new Map<string, number>()
for (const post of posts) {
  feedCounts.set(post.feedName, (feedCounts.get(post.feedName) ?? 0) + 1)
}

const activeFeedsJson = FEEDS
  .map(f => ({ name: f.name, color: f.color, count: feedCounts.get(f.name) ?? 0 }))
  .filter(f => f.count > 0)
  .sort((a, b) => b.count - a.count)

const postsJson = posts.map(p => ({
  title:     p.title,
  url:       p.url,
  feedName:  p.feedName,
  feedColor: p.feedColor,
  date:      p.date.toISOString(),
  excerpt:   p.excerpt,
  imageUrl:  p.imageUrl,
}))

const onlineCount = FEEDS.length - failedCount
---

<Layout>

<!-- ════════════════════════════════════════
     TOP NAV BAR — flat, no shadow
════════════════════════════════════════ -->
<header class="top-nav">
  <div class="top-nav-inner">

    <a href="/" class="site-wordmark" aria-label="permit-any-any home">
      <h1 class="sr-only">Permit-Any-Any — Network Automation &amp; DevNetOps Feed</h1>
      <span aria-hidden="true">
        <span class="wm-cli">$&nbsp;</span><span class="wm-red">permit</span><span class="wm-dark">-any-any</span><span class="wm-cursor">▋</span>
      </span>
    </a>

    <nav class="top-nav-links" aria-label="Primary">
      <a href="#latest"   class="tnl active">Automation</a>
      <a href="/trending" class="tnl">Trending</a>
      <a href="/about"    class="tnl">About</a>
      <button class="tnl" id="top-sources-btn">Sources</button>
    </nav>

    <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open navigation menu" aria-expanded="false">
      <span class="mmb-bar"></span>
      <span class="mmb-bar"></span>
      <span class="mmb-bar"></span>
    </button>

    <div class="top-nav-right">
      <div class="search-field" role="search">
        <label for="q" class="sr-only">Search articles</label>
        <svg class="sf-icon" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="6"/><path d="M15 15l3.5 3.5"/></svg>
        <input id="q" type="search" placeholder="Search parameters…" autocomplete="off" spellcheck="false" />
      </div>
      <div class="live-chip">
        <span class="live-pip" aria-hidden="true"></span>
        <span>{posts.length} articles</span>
      </div>
    </div>

  </div>
</header>


<div id="mobile-overlay" class="mobile-overlay" aria-hidden="true"></div>

<!-- ════════════════════════════════════════
     PAGE SHELL: left sidebar + content + right sidebar
════════════════════════════════════════ -->
<div class="page-shell">

  <!-- ── Fixed left sidebar ── -->
  <aside class="left-sidebar" aria-label="Site navigation">

    <div class="ls-top">
      <div class="ls-logo-block">
        <div class="ls-avatar" aria-hidden="true">
          <span class="ls-avatar-ini">PA</span>
        </div>
        <div>
          <div class="ls-ws-name">Curator Workspace</div>
          <div class="ls-ws-sub">Network Automation</div>
        </div>
      </div>

      <nav class="ls-nav" aria-label="Sidebar navigation">
        <a href="#latest" class="ls-link active" data-section="latest">
          <svg class="ls-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
          <span>Latest</span>
        </a>
        <a href="/trending" class="ls-link" data-section="trending">
          <svg class="ls-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          <span>Trending</span>
        </a>
        <button class="ls-link" id="ls-filter-toggle" aria-expanded="false">
          <svg class="ls-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>
          <span>Sources</span>
        </button>
        <button class="ls-link" id="sort-date-btn" data-sort="date">
          <svg class="ls-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span>By Date</span>
        </button>
        <button class="ls-link" id="sort-az-btn" data-sort="source">
          <svg class="ls-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h10M4 18h6"/><path d="M17 14l3 3-3 3"/></svg>
          <span>A – Z</span>
        </button>
      </nav>
    </div>

    <div class="ls-bottom">
      <button class="ls-cta" onclick="document.getElementById('q').focus()">
        Search Articles
      </button>
      <div class="ls-footer-links">
        <span class="ls-stat">{onlineCount} sources online</span>
        {failedCount > 0 && <span class="ls-offline">⚠ {failedCount} offline</span>}
        <span class="ls-refresh">↻ Refreshes every 6h</span>
      </div>
    </div>

  </aside>


  <!-- ── Main content ── -->
  <main class="main-content" id="latest">

    <!-- Source filter panel (collapsible) -->
    <div id="source-panel" class="source-panel" hidden>
      <div class="sp-header">
        <span class="sp-label">Filter by source</span>
        <button id="sp-clear" class="sp-clear-btn" hidden>Clear ×</button>
      </div>
      <div id="source-chips" class="source-chips" role="group" aria-label="Filter by source"></div>
    </div>

    <!-- Active filter banner -->
    <div id="filter-banner" class="filter-banner" hidden>
      Showing: <strong id="filter-name"></strong>
      <button id="clear-filter" class="fb-clear">Clear filter ×</button>
    </div>

    <!-- Hero -->
    <section class="hero-section" aria-label="Featured article">
      <div id="hero-stage" class="hero-stage">
        <!-- skeleton -->
        <div class="hero-skeleton" aria-hidden="true">
          <div class="hero-sk-gradient"></div>
          <div class="hero-sk-content">
            <div class="sk sk-chip"></div>
            <div class="sk sk-h1"></div>
            <div class="sk sk-h1 sk-short"></div>
            <div class="sk sk-meta"></div>
          </div>
        </div>
      </div>
      <button id="hero-prev" class="h-arrow h-arrow-l" aria-label="Previous">‹</button>
      <button id="hero-next" class="h-arrow h-arrow-r" aria-label="Next">›</button>
      <div id="hero-dots" class="h-dots" role="tablist"></div>
    </section>

    <!-- Latest Stories -->
    <section class="stories-section" id="stories-grid-sec">
      <div class="stories-header">
        <div>
          <h2 class="stories-heading" id="feed-heading">Latest Stories</h2>
          <p class="stories-sub">Critical updates from the edge of automation.</p>
        </div>
        <div class="stories-header-right">
          <span id="results-count" class="results-count" aria-live="polite"></span>
        </div>
      </div>

      <div id="card-grid" class="card-grid">
        {Array.from({ length: 4 }).map(() => (
          <article class="card-skeleton" aria-hidden="true">
            <div class="sk sk-card-img"></div>
            <div class="csk-body">
              <div class="sk sk-chip-sm"></div>
              <div class="sk sk-title"></div>
              <div class="sk sk-title sk-short"></div>
              <div class="sk sk-excerpt"></div>
              <div class="sk sk-date"></div>
            </div>
          </article>
        ))}
      </div>

      <nav id="pagination" class="pagination" aria-label="Article pages" hidden></nav>

      <div id="empty-state" class="empty-state" hidden>
        <p class="es-title">No articles match</p>
        <button id="empty-clear" class="es-btn">Clear filter</button>
      </div>
    </section>

    <!-- Trending section -->
    <section class="trending-section" id="trending" aria-labelledby="trending-heading">
      <div class="stories-header">
        <div>
          <h2 class="stories-heading" id="trending-heading">Trending Now</h2>
          <p class="stories-sub">Most relevant from the network automation community.</p>
        </div>
      </div>
      <ol id="trending-list" class="trending-list"></ol>
    </section>

  </main>


  <!-- ── Right sidebar ── -->
  <aside class="right-sidebar" id="sources" aria-label="Sidebar">

    <!-- Popular this week -->
    <div class="rs-widget">
      <h3 class="rs-heading">Popular This Week</h3>
      <ol id="popular-list" class="popular-list"></ol>
    </div>

    <!-- Browse Sources -->
    <div class="rs-widget rs-sources-widget">
      <h3 class="rs-heading">Trusted Sources</h3>
      <div id="rs-source-list" class="rs-source-list" role="group" aria-label="Filter by source"></div>
    </div>

    <!-- Newsletter -->
    <div class="rs-newsletter">
      <div class="rs-nl-bg" aria-hidden="true">
        <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.12"><path d="M4 4h16v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4z"/><polyline points="4,4 12,13 20,4"/></svg>
      </div>
      <div class="rs-nl-content">
        <h4 class="rs-nl-title">The Briefing.</h4>
        <p class="rs-nl-sub">Weekly synthesis of the most relevant network automation news, directly to your inbox.</p>
        <form class="rs-nl-form" onsubmit="return false">
          <label for="nl-email" class="sr-only">Email address</label>
          <input id="nl-email" type="email" placeholder="email@address.com" autocomplete="email" />
          <button type="submit">Subscribe</button>
        </form>
      </div>
    </div>

  </aside>

</div><!-- /page-shell -->


<!-- ════════════════════════════════════════
     FOOTER
════════════════════════════════════════ -->
<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <div class="footer-logo">permit<span style="color:var(--crimson)">-any-any</span></div>
      <p class="footer-copy">© {new Date().getFullYear()} Precision Curator Network. High-fidelity editorial for the modern network engineer.</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href="#">Privacy Policy</a>
      <a href="/about">About</a>
      <a href="/feed.xml">RSS</a>
      <a href="#">Contact</a>
    </nav>
    <div class="footer-meta">
      <span>{posts.length} articles</span>
      <span>·</span>
      <span>{onlineCount} sources</span>
      {failedCount > 0 && <span style="color:#f59e0b">· {failedCount} offline</span>}
    </div>
  </div>
</footer>

</Layout>


<!-- ════════════════════════════════════════
     STYLES
════════════════════════════════════════ -->
<style is:global>
  /* ─── Reset / utilities ─────────────── */
  .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0 }

  /* ─── Top nav ────────────────────────── */
  .top-nav {
    position:sticky;top:0;z-index:200;
    background:var(--surface);
  }
  .top-nav-inner {
    max-width:1400px;margin:0 auto;
    padding:0 2rem;height:64px;
    display:flex;align-items:center;gap:2rem
  }

  .site-wordmark {
    font-family:'JetBrains Mono',monospace;font-size:1rem;font-weight:700;
    letter-spacing:-0.02em;text-decoration:none;
    display:flex;align-items:baseline;flex-shrink:0
  }
  .wm-cli  { color:var(--outline-var);font-size:0.85em }
  .wm-red  { color:var(--crimson) }
  .wm-dark { color:var(--on-surface) }
  .wm-cursor { color:var(--crimson);animation:blink 1.1s step-end infinite;margin-left:1px }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  .top-nav-links { display:flex;align-items:center;gap:0;flex:1 }
  @media(max-width:720px){.top-nav-links{display:none}}
  .tnl {
    padding:0.35rem 0.875rem;
    font-family:'Space Grotesk',sans-serif;
    font-size:0.73rem;font-weight:700;
    background:none;border-left:none;border-right:none;border-top:none;cursor:pointer;
    letter-spacing:0.06em;text-transform:uppercase;
    color:var(--outline);text-decoration:none;
    border-bottom:2px solid transparent;
    transition:color 0.12s,border-color 0.12s;
    padding-bottom:calc(0.35rem + 2px)
  }
  .tnl:hover { color:var(--on-surface) }
  .tnl.active { color:var(--on-surface);border-bottom-color:var(--on-surface) }

  .top-nav-right { display:flex;align-items:center;gap:1rem;margin-left:auto }

  .search-field { position:relative;display:flex;align-items:center }
  .sf-icon { position:absolute;left:0.75rem;color:var(--outline);pointer-events:none }
  .search-field input {
    background:var(--surface-high);border:none;border-radius:0.25rem;
    padding:0.45rem 0.875rem 0.45rem 2.25rem;
    font-family:'Inter',sans-serif;font-size:0.8rem;color:var(--on-surface);
    outline:none;width:220px;
    transition:background 0.15s,box-shadow 0.15s,width 0.25s
  }
  .search-field input::placeholder { color:var(--outline) }
  .search-field input:focus {
    background:var(--surface-card);
    box-shadow:0 0 0 1.5px var(--surface-tint);width:280px
  }
  @media(max-width:540px){.search-field input{width:150px}.search-field input:focus{width:180px}}

  .live-chip {
    display:inline-flex;align-items:center;gap:0.4rem;
    background:var(--surface-high);border-radius:20px;
    padding:0.3rem 0.75rem;
    font-family:'Inter',sans-serif;font-size:0.68rem;font-weight:600;
    color:var(--on-surface-var)
  }
  .live-pip {
    width:6px;height:6px;border-radius:50%;
    background:var(--tertiary-fixed);flex-shrink:0;
    animation:pulse-live 2.5s ease-in-out infinite
  }
  @keyframes pulse-live { 0%,100%{box-shadow:0 0 0 0 rgba(111,251,190,.5)} 50%{box-shadow:0 0 0 5px rgba(111,251,190,0)} }

  /* ─── Page shell ─────────────────────── */
  .page-shell {
    display:grid;
    grid-template-columns:256px 1fr 280px;
    min-height:calc(100dvh - 64px);
    max-width:1400px;margin:0 auto;
    position:relative
  }
  @media(max-width:1200px){.page-shell{grid-template-columns:220px 1fr;} .right-sidebar{display:none}}
  @media(max-width:840px){
    .page-shell{grid-template-columns:1fr;}
    .left-sidebar{
      display:flex; /* keep flex layout, slide offscreen instead of display:none */
      position:fixed;top:0;left:-280px;width:272px;height:100dvh;
      z-index:300;overflow-y:auto;
      transition:left 0.28s cubic-bezier(.4,0,.2,1);
      box-shadow:none
    }
    .left-sidebar.open{left:0;box-shadow:6px 0 32px rgba(25,28,30,0.18)}
  }

  /* Mobile hamburger */
  .mobile-menu-btn {
    display:none;flex-direction:column;justify-content:center;gap:5px;
    width:36px;height:36px;padding:6px;
    background:none;border:none;cursor:pointer;border-radius:6px;
    margin-left:0.5rem
  }
  @media(max-width:840px){.mobile-menu-btn{display:flex}}
  .mmb-bar {
    display:block;width:18px;height:2px;
    background:var(--on-surface);border-radius:2px;
    transition:transform 0.22s ease, opacity 0.22s ease
  }
  .mobile-menu-btn[aria-expanded="true"] .mmb-bar:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .mobile-menu-btn[aria-expanded="true"] .mmb-bar:nth-child(2){opacity:0}
  .mobile-menu-btn[aria-expanded="true"] .mmb-bar:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

  /* Overlay backdrop */
  .mobile-overlay {
    display:none;position:fixed;inset:0;z-index:299;
    background:rgba(25,28,30,0.4);backdrop-filter:blur(2px);
    transition:opacity 0.22s ease
  }
  .mobile-overlay.open{display:block}

  /* ─── Left sidebar ───────────────────── */
  .left-sidebar {
    position:sticky;top:64px;
    height:calc(100dvh - 64px);
    overflow-y:auto;
    background:var(--surface);
    padding:2rem 1.25rem;
    display:flex;flex-direction:column;
    border-right:0; /* no-line rule */
    /* Tonal separation via background only */
  }
  .ls-top { flex:1 }

  .ls-logo-block {
    display:flex;align-items:center;gap:0.75rem;
    margin-bottom:2.5rem
  }
  .ls-avatar {
    width:40px;height:40px;border-radius:50%;
    background:var(--primary-container);
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0
  }
  .ls-avatar-ini {
    font-family:'Space Grotesk',sans-serif;
    font-size:0.72rem;font-weight:700;
    color:rgba(255,255,255,0.85);letter-spacing:0.05em
  }
  .ls-ws-name { font-family:'Manrope',sans-serif;font-size:0.82rem;font-weight:700;color:var(--on-surface) }
  .ls-ws-sub  { font-size:0.7rem;color:var(--outline);margin-top:0.1rem;font-family:'Inter',sans-serif }

  .ls-nav { display:flex;flex-direction:column;gap:0.25rem }
  .ls-link {
    display:flex;align-items:center;gap:0.75rem;
    padding:0.75rem 1rem;border-radius:0.5rem;
    font-family:'Manrope',sans-serif;font-size:0.82rem;font-weight:600;
    color:var(--outline);text-decoration:none;cursor:pointer;
    border:none;background:none;width:100%;text-align:left;
    transition:color 0.12s,background 0.12s,transform 0.15s
  }
  .ls-link:hover { color:var(--on-surface);background:var(--surface-high);transform:translateX(3px) }
  .ls-link.active { color:var(--on-surface);background:rgba(0,0,0,0.05) }
  .ls-link:focus-visible { outline:2px solid var(--surface-tint);outline-offset:2px }
  .ls-icon { width:18px;height:18px;flex-shrink:0;stroke:currentColor }

  .ls-bottom { margin-top:auto;padding-top:1.5rem }
  .ls-cta {
    width:100%;
    background:var(--on-surface);color:#fff;
    border:none;border-radius:0.375rem;
    padding:0.75rem;
    font-family:'Inter',sans-serif;font-size:0.7rem;font-weight:700;
    letter-spacing:0.08em;text-transform:uppercase;
    cursor:pointer;
    transition:opacity 0.12s
  }
  .ls-cta:hover { opacity:0.85 }
  .ls-cta:focus-visible { outline:2px solid var(--surface-tint);outline-offset:2px }

  .ls-footer-links {
    margin-top:1rem;
    display:flex;flex-direction:column;gap:0.3rem;
    font-family:'Inter',sans-serif;font-size:0.65rem;color:var(--outline)
  }
  .ls-offline { color:#f59e0b }
  .ls-refresh { color:var(--outline-var) }

  /* ─── Main content ───────────────────── */
  .main-content {
    background:var(--surface-low);
    padding:2rem 2.5rem 4rem;
    min-width:0
  }
  @media(max-width:840px){.main-content{padding:1.5rem 1.25rem 4rem}}

  /* Source panel */
  .source-panel {
    background:var(--surface-card);border-radius:0.5rem;
    padding:1.25rem;margin-bottom:1.5rem
  }
  .sp-header {
    display:flex;align-items:center;justify-content:space-between;
    margin-bottom:0.875rem
  }
  .sp-label { font-family:'Space Grotesk',sans-serif;font-size:0.68rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--on-surface) }
  .sp-clear-btn {
    font-size:0.7rem;font-weight:600;color:var(--crimson);
    background:none;border:none;cursor:pointer;padding:0
  }
  .source-chips { display:flex;flex-wrap:wrap;gap:0.5rem }
  .src-chip {
    display:inline-flex;align-items:center;gap:0.35rem;
    padding:0.3rem 0.75rem;border-radius:20px;
    font-family:'Inter',sans-serif;font-size:0.7rem;font-weight:600;
    background:var(--surface-low);color:var(--on-surface-var);
    border:1.5px solid transparent;cursor:pointer;
    transition:border-color 0.12s,background 0.12s,color 0.12s
  }
  .src-chip:hover { background:var(--surface-card);color:var(--on-surface);border-color:var(--outline-var) }
  .src-chip.active { background:var(--on-surface);color:#fff;border-color:var(--on-surface) }
  .src-chip:focus-visible { outline:2px solid var(--surface-tint);outline-offset:2px }
  .src-dot { width:6px;height:6px;border-radius:50%;flex-shrink:0 }

  /* Filter banner */
  .filter-banner[hidden] { display:none }
  .filter-banner {
    display:flex;align-items:center;gap:0.75rem;
    background:var(--surface-card);border-radius:0.25rem;
    border-left:3px solid var(--crimson);
    padding:0.625rem 1rem;margin-bottom:1.5rem;
    font-family:'Inter',sans-serif;font-size:0.8rem;color:var(--on-surface-var)
  }
  .filter-banner strong { color:var(--crimson);font-weight:700 }
  .fb-clear { margin-left:auto;font-size:0.72rem;font-weight:600;color:var(--crimson);background:none;border:none;cursor:pointer }

  /* ─── Hero ───────────────────────────── */
  .hero-section {
    position:relative;
    margin-bottom:3.5rem;
    border-radius:0.75rem;
    overflow:hidden
  }
  .hero-stage {
    aspect-ratio:16/7;
    background:var(--primary-container);
    position:relative;overflow:hidden;border-radius:0.75rem
  }
  .hero-slide {
    position:absolute;inset:0;
    border-radius:0.75rem;overflow:hidden;
    animation:fadeIn 0.5s ease both
  }
  @keyframes fadeIn { from{opacity:0} to{opacity:1} }

  /* Grayscale → color on hover (stitch signature) */
  .hero-img {
    position:absolute;inset:0;
    width:100%;height:100%;object-fit:cover;
    filter:grayscale(85%);
    transition:filter 0.7s ease,transform 0.7s ease;
    z-index:1
  }
