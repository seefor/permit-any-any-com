<script define:vars={{ postsJson, activeFeedsJson }}>
  const ALL_POSTS = postsJson
  const ALL_FEEDS  = activeFeedsJson

  let filter = 'all'
  let query  = ''
  let sort   = 'date'

  // ── Helpers ────────────────────────────────

  const esc = s => String(s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;')

  const relDate = iso => {
    const d = Math.floor((Date.now() - new Date(iso)) / 86400000)
    if (d === 0) return 'Today'
    if (d === 1) return 'Yesterday'
    if (d < 7)   return `${d}d ago`
    if (d < 30)  return `${Math.floor(d/7)}w ago`
    if (d < 365) return `${Math.floor(d/30)}mo ago`
    return `${Math.floor(d/365)}y ago`
  }
  const fmtDate = iso => new Date(iso).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})
  const initials = n => n.split(/[\s\-_]+/).slice(0,2).map(w=>w[0]?.toUpperCase()||'').join('')
  const shortName = n => n.split(' ').slice(0,3).join(' ')

  const POSTS_PER_PAGE = 20
  let currentPage = Math.max(1, parseInt(new URLSearchParams(location.search).get('page') || '1'))

  function setPage(n) {
    currentPage = n
    const url = new URL(location.href)
    if (n === 1) url.searchParams.delete('page')
    else url.searchParams.set('page', n)
    history.pushState({}, '', url)
    document.getElementById('card-grid')?.scrollIntoView({ behavior:'smooth', block:'start' })
    refresh()
  }

  // Compute white or dark text on a hex background
  const badgeFg = hex => {
    const r = parseInt(hex.slice(1,3),16)
    const g = parseInt(hex.slice(3,5),16)
    const b = parseInt(hex.slice(5,7),16)
    // Perceived luminance (WCAG)
    return (0.299*r + 0.587*g + 0.114*b) > 155 ? '#191c1e' : '#ffffff'
  }

  // Layered placeholder + img (no onerror innerHTML injection)
  const mkPh = (color, ini, label, sm) =>
    `<div class="img-ph" style="--ph-color:${esc(color)}">
       ${ini ? `<div class="ph-circle${sm?' ph-circle-sm':''}">${esc(ini)}</div>` : ''}
       ${label ? `<div class="ph-label">${esc(label)}</div>` : ''}
     </div>`
  const mkImg = (url, cls, alt='') =>
    url ? `<img class="${cls}" src="${esc(url)}" alt="${esc(alt)}" width="400" height="300" loading="lazy" onerror="this.style.display='none'">` : ''

  // ── Hero slider ────────────────────────────

  let heroSlides = [], heroIdx = 0, heroTimer = null

  function heroHTML(post) {
    const ini = initials(post.feedName)
    return `
      <div class="hero-slide" role="tabpanel">
        ${mkPh(post.feedColor, ini, '', false)}
        ${post.imageUrl ? `<img class="hero-img" src="${esc(post.imageUrl)}" alt="${esc(post.title)}" width="1200" height="514" loading="eager" fetchpriority="high" onerror="this.style.display='none'">` : ''}
        <div class="hero-gradient"></div>
        <div class="hero-content">
          <div class="hero-tag">${esc(shortName(post.feedName))}</div>
          <h2 class="hero-title">${esc(post.title)}</h2>
          <div class="hero-meta">
            <span class="hero-meta-item">
              <svg class="hero-meta-icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <time datetime="${esc(post.date)}">${fmtDate(post.date)}</time>
            </span>
            <span class="hero-meta-item">
              <svg class="hero-meta-icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              ${esc(shortName(post.feedName))}
            </span>
            <a class="hero-read-cta" href="${esc(post.url)}" target="_blank" rel="noopener noreferrer">Read More →</a>
          </div>
        </div>
      </div>
    `
  }

  function showSlide(idx) {
    heroIdx = (idx + heroSlides.length) % heroSlides.length
    const stage = document.getElementById('hero-stage')
    stage.innerHTML = heroHTML(heroSlides[heroIdx])
    document.querySelectorAll('.h-dot').forEach((d,i) => {
      d.classList.toggle('active', i === heroIdx)
      d.setAttribute('aria-selected', String(i === heroIdx))
    })
  }

  function startAuto() {
    clearInterval(heroTimer)
    heroTimer = setInterval(() => showSlide(heroIdx + 1), 7000)
  }

  function initHero(posts) {
    heroSlides = posts.filter(p => p.imageUrl).slice(0, 6)
    if (!heroSlides.length) heroSlides = posts.slice(0, 6)
    if (!heroSlides.length) return

    const dotsEl = document.getElementById('hero-dots')
    dotsEl.innerHTML = heroSlides.map((_, i) =>
      `<button class="h-dot${i===0?' active':''}" role="tab" aria-selected="${i===0}" aria-label="Slide ${i+1}"></button>`
    ).join('')
    dotsEl.querySelectorAll('.h-dot').forEach((d,i) =>
      d.addEventListener('click', () => { showSlide(i); startAuto() })
    )
    showSlide(0); startAuto()
  }

  document.getElementById('hero-prev').addEventListener('click', () => { showSlide(heroIdx-1); startAuto() })
  document.getElementById('hero-next').addEventListener('click', () => { showSlide(heroIdx+1); startAuto() })
  document.getElementById('hero-section')?.addEventListener('mouseenter', () => clearInterval(heroTimer))
  document.getElementById('hero-section')?.addEventListener('mouseleave', startAuto)

  // ── Card grid ──────────────────────────────

  function cardHTML(post, idx) {
    const delay = Math.min(idx * 35, 450)
    return `
      <article class="story-card" style="animation-delay:${delay}ms">
        <a href="${esc(post.url)}" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
          <div class="sc-img-wrap">
            ${mkPh(post.feedColor, '', '', false)}
            ${mkImg(post.imageUrl, 'sc-img', post.title)}
          </div>
        </a>
        <div class="sc-body">
          <span class="sc-category" style="--sc-badge-bg:${esc(post.feedColor)};--sc-badge-fg:${esc(badgeFg(post.feedColor))}">${esc(post.feedName)}</span>
          <a href="${esc(post.url)}" target="_blank" rel="noopener noreferrer" class="sc-title-link">
            <h3 class="sc-title">${esc(post.title)}</h3>
          </a>
          ${post.excerpt ? `<p class="sc-excerpt">${esc(post.excerpt)}</p>` : ''}
          <div class="sc-footer">
            <a class="sc-read-more" href="${esc(post.url)}" target="_blank" rel="noopener noreferrer">
              Read more
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 6h8M6 2l4 4-4 4"/>
              </svg>
            </a>
            <time class="sc-date" datetime="${esc(post.date)}">${fmtDate(post.date)}</time>
          </div>
        </div>
      </article>
    `
  }

  // ── Trending list ──────────────────────────

  function renderTrending(posts) {
    const list = document.getElementById('trending-list')
    list.innerHTML = posts.slice(0, 8).map((p, i) => {
      const ini = initials(p.feedName)
      return `
        <li>
          <a class="trend-item" href="${esc(p.url)}" target="_blank" rel="noopener noreferrer"
             style="animation-delay:${i*45}ms">
            <span class="trend-num" aria-hidden="true">${String(i+1).padStart(2,'0')}</span>
            <div class="trend-thumb">
              ${mkPh(p.feedColor, ini, '', true)}
              ${mkImg(p.imageUrl, '', p.title)}
            </div>
            <div class="trend-text">
              <span class="trend-cat">${esc(shortName(p.feedName))}</span>
              <div class="trend-title">${esc(p.title)}</div>
              <div class="trend-meta"><time datetime="${esc(p.date)}">${relDate(p.date)}</time></div>
            </div>
          </a>
        </li>
      `
    }).join('')
  }

  // ── Right sidebar: popular (numbered, no thumbs) ──

  function renderPopular() {
    const list = document.getElementById('popular-list')
    list.innerHTML = ALL_POSTS.slice(0, 5).map((p, i) => `
      <li>
        <a class="pop-item" href="${esc(p.url)}" target="_blank" rel="noopener noreferrer">
          <span class="pop-num">${String(i+1).padStart(2,'0')}</span>
          <div class="pop-title">${esc(p.title)}</div>
          <span class="pop-cat">${esc(shortName(p.feedName))}</span>
        </a>
      </li>
    `).join('')
  }

  // ── Right sidebar: source list ─────────────

  function renderRsSourceList() {
    const el = document.getElementById('rs-source-list')
    // Compute counts live from ALL_POSTS so numbers always reflect actual data
    const counts = {}
    ALL_POSTS.forEach(p => { counts[p.feedName] = (counts[p.feedName] || 0) + 1 })

    const sorted = ALL_FEEDS
      .map(f => ({ ...f, count: counts[f.name] || 0 }))
      .filter(f => f.count > 0)
      .sort((a, b) => b.count - a.count)

    el.innerHTML = sorted.map(f => `
      <button class="rs-src-row ${filter===f.name?'active':''}"
              data-feed="${esc(f.name)}" aria-pressed="${filter===f.name}">
        <span class="rs-src-name">${esc(f.name)}</span>
        <span class="rs-src-count">${f.count}</span>
      </button>`
    ).join('')
    el.querySelectorAll('.rs-src-row').forEach(btn =>
      btn.addEventListener('click', () => {
        filter = filter === btn.dataset.feed ? 'all' : btn.dataset.feed
        currentPage = 1
        refresh()
      })
    )
  }

  // ── Source chips (collapsible panel in main) ──

  function renderSourceChips() {
    const chips = document.getElementById('source-chips')
    const allChip = `
      <button class="src-chip ${filter==='all'?'active':''}" data-feed="all" aria-pressed="${filter==='all'}">
        <span class="src-dot" style="background:${filter==='all'?'#fff':'var(--outline-var)'}"></span>
        All
      </button>`
    const rest = ALL_FEEDS.map(f => `
      <button class="src-chip ${filter===f.name?'active':''}" data-feed="${esc(f.name)}"
              aria-pressed="${filter===f.name}" title="${esc(f.name)}">
        <span class="src-dot" style="background:${esc(f.color)}"></span>
        ${esc(shortName(f.name))}
        <span style="opacity:0.6;font-size:0.62em;margin-left:2px">${f.count}</span>
      </button>`
    ).join('')
    chips.innerHTML = allChip + rest
    chips.querySelectorAll('.src-chip').forEach(btn =>
      btn.addEventListener('click', () => { filter = btn.dataset.feed; currentPage=1; refresh() })
    )
  }

  // ── Pagination renderer ─────────────────────

  function renderPagination(totalCards, pageCount) {
    const nav = document.getElementById('pagination')
    if (pageCount <= 1) { nav.hidden = true; return }
    nav.hidden = false
    const p = currentPage

    const pages = []
    // Always show first, last, current ±1, with ellipsis
    const show = new Set([1, pageCount, p, p-1, p+1].filter(n => n >= 1 && n <= pageCount))
    const sorted = [...show].sort((a,b) => a-b)

    let prev = 0
    const items = []
    for (const n of sorted) {
      if (n - prev > 1) items.push(`<span class="pg-ellipsis">…</span>`)
      items.push(`<button class="pg-btn pg-btn-page${n===p?' active':''}" data-pg="${n}" aria-current="${n===p?'page':'false'}">${n}</button>`)
      prev = n
    }

    nav.innerHTML = `
      <button class="pg-btn pg-btn-nav" id="pg-prev" aria-label="Previous page"${p<=1?' disabled':''}>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 2L4 7l5 5"/></svg>
        Prev
      </button>
      ${items.join('')}
      <button class="pg-btn pg-btn-nav" id="pg-next" aria-label="Next page"${p>=pageCount?' disabled':''}>
        Next
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 2l5 5-5 5"/></svg>
      </button>
      <span class="pg-info">Page ${p} of ${pageCount} · ${totalCards} articles</span>
    `
    nav.querySelectorAll('.pg-btn-page').forEach(btn =>
      btn.addEventListener('click', () => setPage(Number(btn.dataset.pg)))
    )
    nav.querySelector('#pg-prev')?.addEventListener('click', () => setPage(p - 1))
    nav.querySelector('#pg-next')?.addEventListener('click', () => setPage(p + 1))
  }

  // ── Main refresh ───────────────────────────

  function refresh() {
    let list = [...ALL_POSTS]
    if (filter !== 'all') list = list.filter(p => p.feedName === filter)
    const q = query.trim().toLowerCase()
    if (q) list = list.filter(p =>
      p.title.toLowerCase().includes(q) ||
      p.feedName.toLowerCase().includes(q) ||
      (p.excerpt||'').toLowerCase().includes(q)
    )
    if (sort === 'source') list.sort((a,b) => a.feedName.localeCompare(b.feedName))

    initHero(list)

    const grid   = document.getElementById('card-grid')
    const empty  = document.getElementById('empty-state')
    const allCards = list.slice(6)  // skip hero posts
    const pageCount = Math.max(1, Math.ceil(allCards.length / POSTS_PER_PAGE))
    currentPage = Math.min(currentPage, pageCount)
    const start = (currentPage - 1) * POSTS_PER_PAGE
    const pagePosts = allCards.slice(start, start + POSTS_PER_PAGE)

    if (list.length === 0) {
      grid.innerHTML = ''; grid.style.display = 'none'
      empty.removeAttribute('hidden')
    } else {
      grid.style.display = 'grid'; empty.setAttribute('hidden', '')
      grid.innerHTML = pagePosts.map((p,i) => cardHTML(p, start + i)).join('')
    }

    renderPagination(allCards.length, pageCount)
    renderTrending(list.slice(1, 9))

    document.getElementById('results-count').textContent =
      `${allCards.length} article${allCards.length!==1?'s':''}`

    const banner = document.getElementById('filter-banner')
    const spClear = document.getElementById('sp-clear')
    if (filter !== 'all') {
      document.getElementById('filter-name').textContent = filter
      banner.removeAttribute('hidden')
      spClear.removeAttribute('hidden')
    } else {
      banner.setAttribute('hidden', '')
      spClear.setAttribute('hidden', '')
    }

    renderSourceChips()
    renderRsSourceList()
  }

  // ── Controls ───────────────────────────────

  document.getElementById('q').addEventListener('input', e => { query=e.target.value; currentPage=1; refresh() })
  document.addEventListener('keydown', e => {
    if (e.key==='/' && document.activeElement?.tagName!=='INPUT' && !e.metaKey) {
      e.preventDefault(); document.getElementById('q').focus()
    }
  })

  // Sort buttons in left sidebar
  document.getElementById('sort-date-btn').addEventListener('click', () => {
    sort='date'; currentPage=1
    document.getElementById('sort-date-btn').classList.add('active')
    document.getElementById('sort-az-btn').classList.remove('active')
    refresh()
  })
  document.getElementById('sort-az-btn').addEventListener('click', () => {
    sort='source'; currentPage=1
    document.getElementById('sort-az-btn').classList.add('active')
    document.getElementById('sort-date-btn').classList.remove('active')
    refresh()
  })

  // Source panel toggle — shared by left sidebar button and top nav button
  const sourcePanel = document.getElementById('source-panel')
  function toggleSourcePanel() {
    const open = sourcePanel.hasAttribute('hidden')
    if (open) sourcePanel.removeAttribute('hidden')
    else sourcePanel.setAttribute('hidden', '')
    document.getElementById('ls-filter-toggle').setAttribute('aria-expanded', String(open))
    document.getElementById('ls-filter-toggle').classList.toggle('active', open)
    document.getElementById('top-sources-btn').classList.toggle('active', open)
    if (open) sourcePanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
  }
  document.getElementById('ls-filter-toggle').addEventListener('click', toggleSourcePanel)
  document.getElementById('top-sources-btn').addEventListener('click', toggleSourcePanel)

  document.getElementById('clear-filter').addEventListener('click', () => { filter='all'; currentPage=1; refresh() })
  document.getElementById('sp-clear').addEventListener('click', () => { filter='all'; currentPage=1; refresh() })
  document.getElementById('empty-clear').addEventListener('click', () => { filter='all'; currentPage=1; refresh() })

  // ── Mobile sidebar drawer ──────────────────
  const mobileBtn     = document.getElementById('mobile-menu-btn')
  const mobileOverlay = document.getElementById('mobile-overlay')
  const leftSidebar   = document.querySelector('.left-sidebar')

  function openMobileNav() {
    leftSidebar.classList.add('open')
    mobileOverlay.classList.add('open')
    mobileBtn.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
  }
  function closeMobileNav() {
    leftSidebar.classList.remove('open')
    mobileOverlay.classList.remove('open')
    mobileBtn.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
  }

  mobileBtn?.addEventListener('click', () =>
    leftSidebar.classList.contains('open') ? closeMobileNav() : openMobileNav()
  )
  mobileOverlay?.addEventListener('click', closeMobileNav)
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMobileNav() })

  // ── Click tracking ────────────────────────
  // Fire-and-forget POST to /api/track whenever a reader opens an article.
  // We use a delegated listener so it covers cards, hero, trending, and popular.

  function trackClick(post) {
    fetch('/api/track', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        url:       post.url,
        title:     post.title,
        feedName:  post.feedName,
        feedColor: post.feedColor,
      }),
      keepalive: true,
    }).catch(() => {/* ignore */})
  }

  document.addEventListener('click', e => {
    const anchor = e.target.closest('a[href]')
    if (!anchor) return
    const href = anchor.getAttribute('href')
    if (!href || href.startsWith('/') || href.startsWith('#')) return
    // Match the href against ALL_POSTS to get full post metadata
    const post = ALL_POSTS.find(p => p.url === href)
    if (post) trackClick(post)
  })

  // ── Init ──────────────────────────────────

  renderPopular()
  renderRsSourceList()
  refresh()
</script>
