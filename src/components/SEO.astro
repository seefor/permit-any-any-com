---
const SITE_URL = 'https://permit-any-any.com'
const SITE_NAME = 'Permit-Any-Any'

interface Props {
  title?: string
  description?: string
  canonical?: string
  ogImage?: string
  ogType?: string
  schema?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  title = `${SITE_NAME} — Network Automation & DevNetOps`,
  description = 'Curated network automation, DevNetOps, and cybersecurity blog feed aggregator for network engineers.',
  canonical = `${SITE_URL}${Astro.url.pathname}`,
  ogImage = '/og-image.png',
  ogType = 'website',
  schema,
} = Astro.props

const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`
const schemaJson = schema ? JSON.stringify(schema) : null
---

<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<title>{title}</title>

<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} Feed`} href={`${SITE_URL}/feed.xml`} />

<!-- Open Graph -->
<meta property="og:type"         content={ogType} />
<meta property="og:site_name"    content={SITE_NAME} />
<meta property="og:title"        content={title} />
<meta property="og:description"  content={description} />
<meta property="og:url"          content={canonical} />
<meta property="og:image"        content={ogImageAbs} />
<meta property="og:image:width"  content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter / X Card -->
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={ogImageAbs} />

{schemaJson && <script type="application/ld+json" set:html={schemaJson} />}
